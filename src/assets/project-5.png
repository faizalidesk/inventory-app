<?xml version="1.0" encoding="UTF-8"?>
<svg width="800" height="480" viewBox="0 0 800 480" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad_studio5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3d0e23" />
      <stop offset="100%" stop-color="#17040d" />
    </linearGradient>

    <!-- Accent Gradient -->
    <linearGradient id="accGrad_studio5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ec4899" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="glow_studio5" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="16" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Ambient Blur Filter -->
    <filter id="ambient_studio5" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="60" />
    </filter>

    <!-- Background Pattern -->
    <pattern id="pat_studio5" width="36" height="36" patternUnits="userSpaceOnUse">
      <path d="M 36 0 L 0 0 0 36" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background Base -->
  <rect width="800" height="480" fill="url(#bgGrad_studio5)" />
  <rect width="800" height="480" fill="url(#pat_studio5)" />

  <!-- Luminous Ambient Orbs -->
  <circle cx="680" cy="100" r="220" fill="#ec4899" opacity="0.32" filter="url(#ambient_studio5)" />
  <circle cx="120" cy="380" r="200" fill="#818cf8" opacity="0.25" filter="url(#ambient_studio5)" />
  <circle cx="400" cy="240" r="140" fill="#f472b6" opacity="0.2" filter="url(#ambient_studio5)" />

  <!-- Central Artwork Geometry -->
  
      <!-- Enterprise 3D Crystal Architecture -->
      <g transform="translate(400, 240)">
        <polygon points="0,-130 112,-65 112,65 0,130 -112,65 -112,-65" fill="none" stroke="url(#accGrad_studio5)" stroke-width="2.5" opacity="0.75" />
        <polygon points="0,-90 78,-45 78,45 0,90 -78,45 -78,-45" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.25)" stroke-width="2" />
        <circle cx="0" cy="0" r="42" fill="url(#accGrad_studio5)" opacity="0.95" filter="url(#glow_studio5)" />
        <circle cx="0" cy="0" r="18" fill="#ffffff" opacity="0.9" />
        <circle cx="0" cy="-130" r="6" fill="#ec4899" filter="url(#glow_studio5)" />
        <circle cx="112" cy="65" r="6" fill="#818cf8" filter="url(#glow_studio5)" />
        <circle cx="-112" cy="65" r="6" fill="#ec4899" filter="url(#glow_studio5)" />
      </g>
      <path d="M 0 350 Q 220 230 440 370 T 800 270" fill="none" stroke="url(#accGrad_studio5)" stroke-width="3" opacity="0.6" />
    
</svg>